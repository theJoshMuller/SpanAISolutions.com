---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Span AI Solutions | Regina, Saskatchewan" description="Get in touch about custom AI solutions, AI consulting or AI voice agents. Based in Regina, Saskatchewan, working with clients worldwide.">
  <main>
    <section class="hero page-shell">
      <p class="eyebrow">Contact Us</p>
      <h1 class="hero-title">Let's talk.</h1>
      <p class="lead">Tell us what you're working toward, and we'll get back to you as soon as possible.</p>
    </section>
    <section class="section page-shell contact-grid">
      <div class="card">
        <h2 class="section-heading">Send an enquiry</h2>
        <p><a href="mailto:sales@spanaisolutions.com">sales@spanaisolutions.com</a></p>
        <a id="enquiry-email" class="button button--primary" href="mailto:sales@spanaisolutions.com">Email us</a>
      </div>
      <aside class="card contact-direct">
        <h2 class="section-heading">Reach us directly</h2>
        <p><a href="mailto:sales@spanaisolutions.com">sales@spanaisolutions.com</a></p>
        <p><a href="tel:+16393823319">+1 (639) 382-3319</a></p>
        <p>Regina, Saskatchewan, Canada. In-person consultations available across Saskatchewan.</p>
        <p><a href="https://www.linkedin.com/in/thejoshmuller/" target="_blank" rel="noopener noreferrer">Josh Muller on LinkedIn ↗</a></p>
        <p><a href="https://www.linkedin.com/in/kamilabuitrago/" target="_blank" rel="noopener noreferrer">Kamila Buitrago on LinkedIn ↗</a></p>
      </aside>
    </section>
  </main>
</BaseLayout>
<script>
  const subjects = new Map([
    ['custom', 'Custom AI solution enquiry'],
    ['consulting', 'AI consulting enquiry'],
    ['voice', 'AI voice agent enquiry'],
  ]);
  const subject = subjects.get(new URLSearchParams(window.location.search).get('service') ?? '');
  const link = document.querySelector<HTMLAnchorElement>('#enquiry-email');
  if (subject && link) link.href = `mailto:sales@spanaisolutions.com?subject=${encodeURIComponent(subject)}`;
</script>
