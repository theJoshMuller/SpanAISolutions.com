      ],
      "parameters": {
        "jsCode": "// Inspect continued errors only after every applicable downstream attempt.\n// Do not include provider error bodies: they can contain credentials or lead data.\nconst monitored = [\n  \"Find Person\",\n  \"Plan Person upsert\",\n  \"Upsert Person\",\n  \"Keep Person ID\",\n  \"Find Company\",\n  \"Plan Company upsert\",\n  \"Upsert Company\",\n  \"Keep Company ID\",\n  \"Link Company to Person\",\n  \"Link Note to Person\",\n  \"Build Task\",\n  \"Create Discovery Task\",\n  \"Task link payload\",\n  \"Link Task to Person\",\n  \"Build ideas prompt\",\n  \"Generate tailored ideas\",\n  \"Build result MIME\",\n  \"Send result email\",\n  \"Tavily company research\",\n  \"Append five research bullets\",\n  \"Update submission Note\"\n];\nconst failed = monitored.filter(name => {\n  const node = $(name);\n  return node.isExecuted && node.all().some(item => item.json.error != null && item.json.error !== false);\n});\nif (failed.length) {\n  const submissionId = $('Envelope').first().json.env.submissionId;\n  throw Error(`Quiz submission ${submissionId}: failed steps: ${failed.join(', ')}. See authenticated execution for details.`);\n}\nreturn $input.all();"
      }
    }
